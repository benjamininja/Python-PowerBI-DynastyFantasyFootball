# ── Playwright session (contains browser tokens / secrets) ───────────────────
data/.pw_profile/
# ── Unneccessary ─────────────────────────────────────────────────────────────
data/raw/
data/review/
data/outputs/
# Private tables (docs/data_model.yml, schema not football): a local parquet-mode
# copy is never committed or published (#93).
data/dim_fantrax_crosswalk_override.parquet
data/fact_startup_draft_slot.parquet
data/dim_startup_draft_scorer.parquet
skills/
# Project skills under .claude/skills/ are tracked (#490); the rule above is for
# the repo-root skills/ reference folder.
!/.claude/skills/

# ── Credentials ───────────────────────────────────────────────────────────────
# Ignore every .env anywhere: bare, prefixed (foo.env), and dotted (.env.local,
# .env.production) at any directory depth. Keep .env.example tracked as a template.
.env
*.env
.env.*
!.env.example
!**/.env.example
api_key.txt

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
.botvenv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/settings.json
# Claude Code per-developer local settings (permissions allowlist etc.) — not shared.
.claude/settings.json
.claude/settings.local.json
.claude/learnings.db
# A builder session's working notes and message body files (#234). Never tracked.
builder-state/
# Generated by scripts/build_schedule_page.py at site build (#386). Never tracked.
docs/site/pages/refresh-schedule.md
pbi/.claude/
Prompts.txt

# ── mouserat_trade-bud static site build output ───────────────────────────────
# Regenerated from committed parquet by export_static.py (and by the Pages
# workflow on every deploy) — never committed, so it cannot drift from data/.
mouserat_trade-bud/_site/

# ── Pages build output (trade-bud at the root, docs site under /docs/) ────────
# Built by .github/workflows/pages.yml and checked by docs-build.yml; the
# generator's cache folder is local only.
/_site/
/.cache/

# ── Power BI project (PBIP) local artifacts ───────────────────────────────────
**/.pbi/
*.abf
# Auto-generated time-intelligence tables — Power BI recreates these on open.
**/LocalDateTable_*.tmdl
**/DateTableTemplate_*.tmdl
# James HoD reference stack — embeds secrets, never commit
docs/reference/
