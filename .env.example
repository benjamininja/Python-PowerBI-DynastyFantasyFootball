# Copy to .env at the repo root and fill in real values. .env is gitignored.

# Fantrax login for the headless scrapers (04a/04v/04w).
FANTRAX_EMAIL=you@example.com
FANTRAX_PASSWORD=your-password

# Optional: Discord webhook for pipeline run summaries (scripts/run_pipeline.py).
# Create in a private channel: Channel Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=
# Named destinations. DISCORD_WEBHOOK_URL above is the one the pipeline posts
# to today; copy one of these onto it to switch.
#   _dev   = the development channel
#   _admin = the admin server
#   _main  = the main league chat
DISCORD_WEBHOOK_URL_dev=
DISCORD_WEBHOOK_URL_admin=
DISCORD_WEBHOOK_URL_main=

# Fantrax two-factor setup key (the bare base32 key, not the otpauth:// line).
FANTRAX_TOTP_SECRET=

# Supabase Postgres, session pooler URI (ADR-0014).
SUPABASE_DB_URL=
