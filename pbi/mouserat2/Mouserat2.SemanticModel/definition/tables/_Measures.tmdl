/// Calculation-only table holding dynasty ranking measures (latest-snapshot, format-aware). No data columns.
table _Measures
	lineageTag: 57028ca8-1211-42cb-a1c2-3f3212eb23a5

	/// Raw sum of metric_num. Legacy matrix base; double-counts format-agnostic metrics. Prefer the per-metric measures.
	measure 'Metric Sum' = SUM ( Fact_DynastyRankingMetrics[MetricNum] )
		displayFolder: Dynasty Rankings
		lineageTag: b58aaced-ad1a-4f85-a2ec-10fbe60d1ed3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

		annotation Synonyms = metric sum|total metric|sum of metrics|raw metric total

		annotation SynonymCollection = ["metric sum","total metric","sum of metrics","raw metric total"]

	/// Base: selected metric_num at the latest snapshot, averaged across formats in context. Player-grain building block.
	measure 'Metric Value' =
			VAR _latest =
			    CALCULATE ( MAX ( Fact_DynastyRankingMetrics[SnapshotDate] ), ALLSELECTED ( Fact_DynastyRankingMetrics[SnapshotDate] ) )
			RETURN
			    CALCULATE ( AVERAGE ( Fact_DynastyRankingMetrics[MetricNum] ), Fact_DynastyRankingMetrics[SnapshotDate] = _latest )
		isHidden
		displayFolder: Dynasty Rankings\_base
		lineageTag: 4e46332c-29a8-4656-9048-3ad333380cf8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Base: averages the per-player metric value across all players in context (subtotal-correct for values and ranks).
	measure 'Metric Value Total' =
			VAR _latest =
			    CALCULATE ( MAX ( Fact_DynastyRankingMetrics[SnapshotDate] ), ALLSELECTED ( Fact_DynastyRankingMetrics[SnapshotDate] ) )
			RETURN
			    AVERAGEX (
			        VALUES ( Fact_DynastyRankingMetrics[SourceUID] ),
			        CALCULATE ( AVERAGE ( Fact_DynastyRankingMetrics[MetricNum] ), Fact_DynastyRankingMetrics[SnapshotDate] = _latest )
			    )
		isHidden
		displayFolder: Dynasty Rankings\_base
		lineageTag: c797f2dc-bcac-45b3-aa6c-79af01f243f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Base: sums the per-player metric value across all players in context (subtotal-correct for crowd counts).
	measure 'Metric Count Total' =
			VAR _latest =
			    CALCULATE ( MAX ( Fact_DynastyRankingMetrics[SnapshotDate] ), ALLSELECTED ( Fact_DynastyRankingMetrics[SnapshotDate] ) )
			RETURN
			    SUMX (
			        VALUES ( Fact_DynastyRankingMetrics[SourceUID] ),
			        CALCULATE ( AVERAGE ( Fact_DynastyRankingMetrics[MetricNum] ), Fact_DynastyRankingMetrics[SnapshotDate] = _latest )
			    )
		isHidden
		displayFolder: Dynasty Rankings\_base
		lineageTag: 74f66c7a-7921-4c74-ab8e-7f05b326a830

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// DynastySharks 3D Value+ score at the latest snapshot, averaged across formats. Higher is better.
	measure 'DS 3D Value+' = CALCULATE ( [Metric Value], Dim_DynastyMetric[MetricKey] = "ds_value" )
		formatString: 0.0
		displayFolder: Dynasty Rankings
		lineageTag: 36317d9f-e879-46c1-9b89-4f5f1faaad99

		annotation Synonyms = dynastysharks value|3d value|ds value|sharks value|dynasty value

		annotation SynonymCollection = ["dynastysharks value","3d value","ds value","sharks value","dynasty value"]

	/// DynastySharks 1-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better.
	measure 'Proj 1-Yr' = CALCULATE ( [Metric Value], Dim_DynastyMetric[MetricKey] = "proj_1yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings
		lineageTag: ac0c03b4-a6f0-4378-bbcd-aefb637dcdfc

		annotation Synonyms = 1 year projection|one year|proj 1yr|short term projection|projected points

		annotation SynonymCollection = ["1 year projection","one year","proj 1yr","short term projection","projected points"]

	/// DynastySharks 3-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better.
	measure 'Proj 3-Yr' = CALCULATE ( [Metric Value], Dim_DynastyMetric[MetricKey] = "proj_3yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings
		lineageTag: 014a1dd1-5df1-455e-b248-9c01a92b4a63

		annotation Synonyms = 3 year projection|three year|proj 3yr|projected points|outlook

		annotation SynonymCollection = ["3 year projection","three year","proj 3yr","projected points","outlook"]

	/// DynastySharks 5-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better.
	measure 'Proj 5-Yr' = CALCULATE ( [Metric Value], Dim_DynastyMetric[MetricKey] = "proj_5yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings
		lineageTag: 67d5c706-e109-49b0-93c9-e7604d6ed72c

		annotation Synonyms = 5 year projection|five year|proj 5yr|projected points|long term

		annotation SynonymCollection = ["5 year projection","five year","proj 5yr","projected points","long term"]

	/// DynastySharks 10-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better.
	measure 'Proj 10-Yr' = CALCULATE ( [Metric Value], Dim_DynastyMetric[MetricKey] = "proj_10yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings
		lineageTag: cdcd74a2-4e19-4e95-a600-f6a877c4f13a

		annotation Synonyms = 10 year projection|ten year|proj 10yr|career projection|long term value

		annotation SynonymCollection = ["10 year projection","ten year","proj 10yr","career projection","long term value"]

	/// Average draft position at the latest snapshot, averaged across formats. Lower ADP means drafted earlier. Uses the blended Composite ADP across all dynasty sources (metric_key "composite_adp") -- fixed 2026-07-11, was filtering on "adp", a metric_key that doesn't exist in dim_dynasty_metric (real keys are ds_adp/composite_adp), so this measure was always blank everywhere, not just alongside salary fields. IsRosterRow gate added 2026-07-11: Dim_Contract is an 11-row rule lookup (Minor/1st/2nd/.../FA) unrelated to Fact_DynastyRankingMetrics, so ADP ignores the Contract row filter and returns the same player value regardless of which contract row is in context. The 9999 sentinel used to fill in for every one of those 10 rows per player (not just their real contract), and a non-blank measure defeats the matrix's blank-row suppression -- so every player showed all 10 phantom contract combinations with blank salary fields next to a repeated ADP. Gating on COUNTROWS(Fact_FantasyTeams) > 0 restores blank on the 9 non-matching combos so they go back to being suppressed, and only fills 9999 on the one real roster row.
	measure ADP =
			
			VAR adp = CALCULATE ( [Metric Value], Dim_DynastyMetric[MetricKey] = "composite_adp" )
			VAR IsRosterRow = COUNTROWS ( Fact_FantasyTeams ) > 0
			
			RETURN
			SWITCH( TRUE(),
			NOT IsRosterRow, BLANK(),
			NOT ISBLANK(adp), adp,
			9999.0)
		formatString: 0.0
		displayFolder: Dynasty Rankings
		lineageTag: a5a5728e-d719-481f-85cd-ac8fd670dab1

		annotation Synonyms = adp|average draft position|draft position|draft cost|redraft adp

		annotation SynonymCollection = ["adp","average draft position","draft position","draft cost","redraft adp"]

	/// DynastySharks 3D Value+ score at the latest snapshot, averaged across formats. Higher is better. Subtotal-correct across players (averaged).
	measure 'DS 3D Value+ (total)' = CALCULATE ( [Metric Value Total], Dim_DynastyMetric[MetricKey] = "ds_value" )
		formatString: 0.0
		displayFolder: Dynasty Rankings - extra
		lineageTag: e3609e74-ade9-4e84-876d-f3edaf4a74b2

		annotation Synonyms = dynastysharks value|3d value|ds value|sharks value|dynasty value

		annotation SynonymCollection = ["dynastysharks value","3d value","ds value","sharks value","dynasty value"]

	/// DynastySharks 1-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better. Subtotal-correct across players (averaged).
	measure 'Proj 1-Yr (total)' = CALCULATE ( [Metric Value Total], Dim_DynastyMetric[MetricKey] = "proj_1yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings - extra
		lineageTag: 407b9048-babc-4b6d-b76e-0640aa82a631

		annotation Synonyms = 1 year projection|one year|proj 1yr|short term projection|projected points

		annotation SynonymCollection = ["1 year projection","one year","proj 1yr","short term projection","projected points"]

	/// DynastySharks 3-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better. Subtotal-correct across players (averaged).
	measure 'Proj 3-Yr (total)' = CALCULATE ( [Metric Value Total], Dim_DynastyMetric[MetricKey] = "proj_3yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings - extra
		lineageTag: b39f2bec-2008-4525-bc15-4d60dac90485

		annotation Synonyms = 3 year projection|three year|proj 3yr|projected points|outlook

		annotation SynonymCollection = ["3 year projection","three year","proj 3yr","projected points","outlook"]

	/// DynastySharks 5-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better. Subtotal-correct across players (averaged).
	measure 'Proj 5-Yr (total)' = CALCULATE ( [Metric Value Total], Dim_DynastyMetric[MetricKey] = "proj_5yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings - extra
		lineageTag: 7a9f66a0-1048-451c-94db-4e31fff9e8f8

		annotation Synonyms = 5 year projection|five year|proj 5yr|projected points|long term

		annotation SynonymCollection = ["5 year projection","five year","proj 5yr","projected points","long term"]

	/// DynastySharks 10-year fantasy point projection at the latest snapshot, averaged across formats. Higher is better. Subtotal-correct across players (averaged).
	measure 'Proj 10-Yr (total)' = CALCULATE ( [Metric Value Total], Dim_DynastyMetric[MetricKey] = "proj_10yr" )
		formatString: #,##0
		displayFolder: Dynasty Rankings - extra
		lineageTag: f426b9b7-1779-4612-be38-4a9c0ece2d23

		annotation Synonyms = 10 year projection|ten year|proj 10yr|career projection|long term value

		annotation SynonymCollection = ["10 year projection","ten year","proj 10yr","career projection","long term value"]

	/// Average draft position at the latest snapshot, averaged across formats. Lower ADP means drafted earlier. Subtotal-correct across players (averaged). Same "composite_adp" fix as 'ADP' -- was filtering on a metric_key that doesn't exist.
	measure 'ADP (total)' = CALCULATE ( [Metric Value Total], Dim_DynastyMetric[MetricKey] = "composite_adp" )
		formatString: 0.0
		displayFolder: Dynasty Rankings - extra
		lineageTag: a7a41fcf-585b-4a8c-aa52-ab3dcb2d0cb2

		annotation Synonyms = adp|average draft position|draft position|draft cost|redraft adp

		annotation SynonymCollection = ["adp","average draft position","draft position","draft cost","redraft adp"]

	/// Latest-snapshot scouting/analysis blurb for the player (text). Source: DynastySharks.
	measure Analysis =
			VAR _latest =
			    CALCULATE ( MAX ( Fact_DynastyRankingMetrics[SnapshotDate] ), ALLSELECTED ( Fact_DynastyRankingMetrics[SnapshotDate] ) )
			RETURN
			    CALCULATE ( MAX ( Fact_DynastyRankingMetrics[MetricText] ), Dim_DynastyMetric[MetricKey] = "analysis", Fact_DynastyRankingMetrics[SnapshotDate] = _latest )
		displayFolder: Dynasty Rankings
		lineageTag: e73e1239-68e8-4b7e-bade-3ac1c818ced4

		annotation Synonyms = analysis|blurb|scouting report|notes|writeup

		annotation SynonymCollection = ["analysis","blurb","scouting report","notes","writeup"]

	/// Player's cap hit as a percent of their team's total starting cap. Live calc against Fact_FantasyTeams + Dim_FantasyTeams[OriginalCap] -- no ETL-frozen rollup.
	measure 'Player Pct of Team Cap' =
			
			VAR PlayerCapHit =
			    [Active Roster Salary]
			
			VAR TeamTotalCap =
			    CALCULATE(
			        [Starting Salary Cap],
			        ALLEXCEPT('Dim_FantasyTeams', 'Dim_FantasyTeams'[TeamName])
			    )
			
			RETURN
			    DIVIDE(PlayerCapHit, TeamTotalCap, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Salary & Cap
		lineageTag: 1b7b8790-b0fd-4943-b181-4311669cf879

	/// This season's cap charge for rostered players: full ContractValue. Salary in the Minors and IR slots (RosterSlot Minors or IR) is cap-exempt; a blank slot charges normally.
	measure 'Active Roster Salary' =

			CALCULATE(
			    SUM(Fact_FantasyTeams[ContractValue]),
			    Dim_Season[relative_nfl_season_number] = 0,
			    Fact_FantasyTeams[RosterSlot] <> "Minors",
			    Fact_FantasyTeams[RosterSlot] <> "IR"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: f6e934e4-6811-44cf-ac61-1c3c7edd16fa

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Starting Salary Cap' = SUM(Dim_FantasyTeams[OriginalCap])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: 13ef7dc7-b523-4094-bcde-9a46721b524f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Starting cap minus rostered salary, this season's dead money (Fact_DeadMoney) and reinvestment cap. Minors and IR slot salary (RosterSlot Minors, IR) is cap-exempt.
	measure 'Remaining Salary Cap' = [Starting Salary Cap] - CALCULATE ( [Contract Value], Fact_FantasyTeams[RosterSlot] <> "Minors", Fact_FantasyTeams[RosterSlot] <> "IR" ) - [Dead Money - Active - Current Year] - SUM('Dim_FantasyTeams'[ReinvestmentCap])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: bfbe96fa-03d3-490f-a572-6dfb91da9c92

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Percent of Cap Remaining' = DIVIDE ( [Remaining Salary Cap], [Starting Salary Cap] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Salary & Cap
		lineageTag: 6451e6d3-5723-4487-bd35-5c7af1895463

	measure 'Percent of Cap Used' = ```
			
			SWITCH ( 
			    TRUE(), 
			    NOT ISBLANK([Percent of Cap Remaining]),
			        1 - [Percent of Cap Remaining],
			    BLANK() 
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Salary & Cap
		lineageTag: 6eec5cc5-4191-4e2d-91c9-ac855c158cc1

	/// Total multi-year contract value of the active roster (not just this year's cap charge -- see 'Active Roster Salary' for that).
	measure 'Contract Value' = SUM(Fact_FantasyTeams[ContractValue])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: 3280ec07-3c3a-47c1-8770-c8d7eaa1c62a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Dead money charged to the cap this season: the sum of Fact_DeadMoney for the current season, from drops of guaranteed contracts. Blank when a team has no charge.
	measure 'Dead Money - Active - Current Year' =
			
			CALCULATE(
			    SUM(Fact_DeadMoney[DeadMoney]),
			    Dim_Season[relative_nfl_season_number] = 0
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: ccab9ac4-5f71-4ae1-a459-af6f37e399bd

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Dead money already owed against next season's cap: the sum of Fact_DeadMoney for the season after the current one (e.g. the .40 year of a dropped 1st contract).
	measure 'Dead Money - Active - Next Year' =
			
			CALCULATE(
			    SUM(Fact_DeadMoney[DeadMoney]),
			    Dim_Season[relative_nfl_season_number] = 1
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: 2465b3f2-d177-4dcb-ad69-a6cf7d93e20a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Dead money owed from the current season on: the sum of Fact_DeadMoney for the current and every later season (e.g. .50 + .40 of a dropped 1st contract).
	measure 'Dead Money - Active - Total' =
			
			CALCULATE(
			    SUM(Fact_DeadMoney[DeadMoney]),
			    Dim_Season[relative_nfl_season_number] >= 0
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: f6a58ab2-6ba6-4cba-a848-5309d9bbc59e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// What-if: this season's dead money if every rostered player on a guaranteed contract were cut today. Reads the roster, not Fact_DeadMoney; real charges are the Active measures.
	measure 'Dead Money - Speculative - Current Year' =
			
			CALCULATE(
			    SUMX(
			        Fact_FantasyTeams,
			        IF(
			            RELATED(Dim_Contract[Guaranteed]),
			            Fact_FantasyTeams[ContractValue] * RELATED(Dim_Contract[CapHitPct]),
			            0
			        )
			    ),
			    Dim_Season[relative_nfl_season_number] = 0
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: 2a522abd-aa42-4abe-81e3-27be8d82a8d2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// What-if: next season's dead money if every rostered player on a guaranteed contract were cut after this one (the contract's year+1 CapHitPct). Reads the roster, not Fact_DeadMoney.
	measure 'Dead Money - Speculative - Next Year' =
			
			CALCULATE(
			    SUMX(
			        Fact_FantasyTeams,
			        VAR NextPct =
			            LOOKUPVALUE(
			                Dim_Contract[CapHitPct],
			                Dim_Contract[ContractType], RELATED(Dim_Contract[ContractType]),
			                Dim_Contract[TotalYears], RELATED(Dim_Contract[TotalYears]),
			                Dim_Contract[ContractYear], RELATED(Dim_Contract[ContractYear]) + 1
			            )
			        RETURN
			            IF(
			                RELATED(Dim_Contract[Guaranteed]) && NOT ISBLANK(NextPct),
			                Fact_FantasyTeams[ContractValue] * NextPct,
			                0
			            )
			    ),
			    Dim_Season[relative_nfl_season_number] = 0
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: 2d23f47b-42d9-41ef-b60b-8484652f1c28

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// What-if: dead money over the rest of the contract cycle if every rostered player on a guaranteed contract were cut today. The "should I cut this guy" number. Reads the roster, not Fact_DeadMoney.
	measure 'Dead Money - Speculative - Total' =
			
			CALCULATE(
			    SUMX(
			        Fact_FantasyTeams,
			        VAR CT = RELATED(Dim_Contract[ContractType])
			        VAR TY = RELATED(Dim_Contract[TotalYears])
			        VAR CY = RELATED(Dim_Contract[ContractYear])
			        VAR RemainingPct =
			            SUMX(
			                FILTER(
			                    ALL(Dim_Contract),
			                    Dim_Contract[ContractType] = CT
			                        && Dim_Contract[TotalYears] = TY
			                        && Dim_Contract[ContractYear] >= CY
			                ),
			                Dim_Contract[CapHitPct]
			            )
			        RETURN
			            IF(
			                RELATED(Dim_Contract[Guaranteed]),
			                Fact_FantasyTeams[ContractValue] * RemainingPct,
			                0
			            )
			    ),
			    Dim_Season[relative_nfl_season_number] = 0
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salary & Cap
		lineageTag: 9b798d2d-afc0-40ce-9ed1-53a861fda9fc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Player's Contract Value rank within their own team (1 = highest-paid), ignoring whatever player-level filter the visual currently has. ALLEXCEPT keeps only the TeamKey filter, so RANKX iterates every roster row on that team regardless of which players are otherwise shown. Not a Top N report filter (PBI's built-in Top N is global, not per-group) -- drag this into a visual's Filters pane and set "is less than or equal to 5" to get top-5-per-team in one chart.
	measure 'Contract Value Rank in Team' =
			
			RANKX(
			    ALLEXCEPT(Fact_FantasyTeams, Fact_FantasyTeams[TeamKey]),
			    [Contract Value]
			)
		formatString: 0
		displayFolder: Salary & Cap
		lineageTag: d3ca52a0-3638-4350-8318-8d9c3c5b4ea8

	/// Hidden placeholder column for this measure-only table. Not for reporting.
	column _Measures
		dataType: string
		isHidden
		lineageTag: a1b44d89-5f44-4f2f-bc55-f762d20c8b0b
		summarizeBy: none
		sourceColumn: _Measures

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = ""
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

	annotation Synonyms = Measures|Dynasty Measures|Metrics|Calculations|KPIs

	annotation SynonymCollection = ["Measures","Dynasty Measures","Metrics","Calculations","KPIs"]

